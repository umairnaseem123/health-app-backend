# App
APP_NAME=AI Health Monitoring & Early Virus Risk Detection Platform
ENV=development
DEBUG=True

# Database
# For SQLite (default, easy local dev):
DATABASE_URL=sqlite:///./health_platform.db
# For PostgreSQL (production example):
# DATABASE_URL=postgresql://user:password@localhost:5432/health_platform

# JWT / Security
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Emergency Notification (placeholders - plug in real provider later)
EMERGENCY_ALERT_ENABLED=True
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
